{
  "protocol": "pire-plugin-v1",
  "id": "example.echo",
  "version": "1.0.0",
  "description": "Example slash-command and read-only tool sidecar",
  "dependencies": [],
  "command": ["python3", "examples/plugins/echo_sidecar.py"],
  "timeout_secs": 30,
  "max_message_bytes": 1048576,
  "providers": [],
  "tools": [
    {
      "definition": {
        "name": "word_count",
        "description": "Count whitespace-delimited words without accessing the workspace",
        "input_schema": {
          "type": "object",
          "properties": {
            "text": { "type": "string" }
          },
          "required": ["text"],
          "additionalProperties": false
        }
      },
      "operation": "read"
    }
  ],
  "commands": [
    {
      "name": "echo",
      "description": "Echo slash-command arguments"
    }
  ]
}
